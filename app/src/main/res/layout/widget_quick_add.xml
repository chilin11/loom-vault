<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_surface"
    android:paddingLeft="18dp"
    android:paddingTop="14dp"
    android:paddingRight="18dp"
    android:paddingBottom="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✦  LOOM / 密语"
        android:textColor="#C5E8A5"
        android:textSize="13sp"
        android:textStyle="bold"
        android:singleLine="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="灵感来了，先记下来。"
        android:textColor="#F1F5F2"
        android:textSize="16sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_add_button"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="11dp"
        android:background="@drawable/widget_button"
        android:contentDescription="解锁并快速新建密码记录"
        android:gravity="center"
        android:text="＋  快速新建"
        android:textColor="#101A1D"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
